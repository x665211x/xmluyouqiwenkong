{
  "config": {
    "step": {
      "user": {
        "title": "小米路由器温控（Telnet）",
        "description": "填写路由器的局域网 IP 与 Telnet 登录信息。已开启 Telnet 的小米路由器一般是 192.168.31.1、端口 23、用户 root；如果 Telnet 直接进入 root shell，密码留空即可。",
        "data": {
          "host": "路由器 IP 地址",
